{
  "arazzo": "1.0.1",
  "info": {"title": "Payments", "version": "1"},
  "sourceDescriptions": [{"name": "payments", "url": "./payments.openapi.yaml", "type": "openapi"}],
  "workflows": [
    {
      "workflowId": "pay",
      "inputs": {"type": "object", "properties": {"amount": {"type": "integer"}}},
      "steps": [
        {
          "stepId": "charge",
          "operationId": "createCharge",
          "parameters": [{"name": "Idempotency-Key", "in": "header", "value": "$inputs.key"}],
          "successCriteria": [
            {"context": "$response.body", "condition": "$.status", "type": "jsonpath", "version": "draft-goessner-dispatch-jsonpath-00"}
          ],
          "onFailure": [{"name": "declined", "type": "end", "criteria": [{"condition": "$statusCode == 402"}]}],
          "outputs": {"chargeId": "$response.body#/id"}
        },
        {"stepId": "receipt", "operationId": "createReceipt"}
      ]
    }
  ]
}
