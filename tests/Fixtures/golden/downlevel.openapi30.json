{
  "openapi": "3.0.4",
  "info": {
    "title": "Downlevel API",
    "description": "Every construct the 3.0 downlevel has to convert or degrade.",
    "license": {
      "name": "MIT",
      "url": "https://spdx.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/shared": {
      "summary": "A path item OpenAPI 3.0 has no components.pathItems to reference",
      "get": {
        "operationId": "shared.get",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/things": {
      "post": {
        "operationId": "things.store",
        "summary": "Create a thing",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 5
            }
          },
          {
            "name": "trace",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "exclusiveMaximum": true,
              "minimum": 0,
              "exclusiveMinimum": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "A sibling beside a $ref",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Thing"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                },
                "examples": {
                  "one": {
                    "value": {
                      "kind": "widget",
                      "schema": "a user value keyed like a schema position"
                    }
                  },
                  "two": {
                    "$ref": "#/components/examples/examples"
                  }
                }
              }
            },
            "links": {
              "audit": {
                "$ref": "#/components/links/parameters"
              },
              "self": {
                "description": "The thing this request created",
                "operationId": "things.show",
                "parameters": {
                  "path.id": "$response.body#/id",
                  "schema": "a link parameter keyed like a schema position"
                },
                "requestBody": {
                  "$ref": "#/components/schemas/Thing",
                  "description": "Kept, because a Link's requestBody is user data",
                  "summary": "A body member spelled like a reference's own wording"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/example"
          },
          "default": {
            "description": "An unexpected error",
            "headers": {
              "default": {
                "description": "A header named like a fixed field",
                "schema": {
                  "type": "string",
                  "nullable": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "minimum": 3,
                      "exclusiveMinimum": true
                    },
                    "kind": {
                      "enum": [
                        "error"
                      ]
                    }
                  },
                  "nullable": true
                }
              }
            }
          }
        },
        "callbacks": {
          "onCreated": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "operationId": "things.created.callback",
                "responses": {
                  "default": {
                    "description": "This operation's responses are not described, so no status code or body is guaranteed."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/things/deferred": {
      "get": {
        "operationId": "things.deferred",
        "summary": "An operation whose responses the build could not recover",
        "responses": {
          "default": {
            "description": "This operation's responses are not described, so no status code or body is guaranteed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "string",
        "enum": [
          "draft",
          "published"
        ]
      },
      "Thing": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": "string",
            "format": "byte"
          },
          "branch": {},
          "extras": {
            "type": "object"
          },
          "flag": {
            "type": "boolean",
            "enum": [
              true,
              false
            ]
          },
          "kind": {
            "enum": [
              "widget"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nickname": {
            "type": "string",
            "maxLength": 20,
            "nullable": true
          },
          "note": {
            "type": "string",
            "example": "already set"
          },
          "nothing": {
            "nullable": true
          },
          "payload": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "example": 1
          },
          "signature": {
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Status"
              }
            ],
            "nullable": true
          },
          "weight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "responses": {
      "default": {
        "description": "A component named like a fixed field",
        "content": {
          "application/json": {
            "schema": {
              "type": "string",
              "enum": [
                "unavailable"
              ],
              "nullable": true
            }
          }
        }
      },
      "example": {
        "description": "A component named like a member whose value is user data",
        "content": {
          "application/json": {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true
            }
          }
        }
      }
    },
    "examples": {
      "examples": {
        "summary": "An example in the bucket that really is one",
        "value": {
          "kind": "widget"
        }
      }
    },
    "headers": {
      "enum": {
        "description": "A component named like a schema keyword",
        "schema": {
          "type": "boolean",
          "nullable": true
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      }
    },
    "links": {
      "parameters": {
        "description": "A link component named like a fixed field of the object it is",
        "operationId": "things.audit",
        "parameters": {
          "paths": "a link parameter keyed like a path-item map"
        }
      }
    }
  }
}
