{
  "$schema": "https://spec.docuccino.app/uir/1.0/schema.json",
  "uir": "1.0.0",
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.2/dialect/base",
  "info": {
    "title": "Downlevel API",
    "summary": "A summary OpenAPI 3.0 has nowhere to put.",
    "description": "Every construct the 3.0 downlevel has to convert or degrade.",
    "license": { "name": "MIT", "identifier": "MIT" },
    "version": "1.0.0"
  },
  "security": [
    { "clientCert": [] },
    { "apiKey": [], "clientCert": [] }
  ],
  "paths": {
    "/things": {
      "post": {
        "operationId": "things.store",
        "summary": "Create a thing",
        "security": [
          { "clientCert": [] }
        ],
        "parameters": [
          {
            "name": "trace",
            "in": "query",
            "required": false,
            "schema": { "type": ["string", "null"], "$comment": "an annotation with no 3.0 home" }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": ["string", "integer"] }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "exclusiveMinimum": 0, "exclusiveMaximum": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 5, "exclusiveMinimum": 0 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Thing", "description": "A sibling beside a $ref" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Thing" },
                "examples": {
                  "one": { "value": { "kind": "widget", "schema": "a user value keyed like a schema position" } },
                  "two": { "$ref": "#/components/examples/examples", "summary": "A reference's own wording, inside the bucket that really is examples" }
                }
              }
            },
            "links": {
              "self": {
                "operationId": "things.show",
                "description": "The thing this request created",
                "parameters": { "path.id": "$response.body#/id", "schema": "a link parameter keyed like a schema position" },
                "requestBody": {
                  "$ref": "#/components/schemas/Thing",
                  "summary": "A body member spelled like a reference's own wording",
                  "description": "Kept, because a Link's requestBody is user data"
                }
              },
              "audit": { "$ref": "#/components/links/parameters", "summary": "A reference's own wording, inside the map that really is links" }
            }
          },
          "404": { "$ref": "#/components/responses/example" },
          "default": {
            "description": "An unexpected error",
            "headers": {
              "default": { "description": "A header named like a fixed field", "schema": { "type": ["string", "null"] } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": ["object", "null"],
                  "properties": {
                    "kind": { "const": "error" },
                    "code": { "type": "integer", "exclusiveMinimum": 3 }
                  }
                }
              }
            }
          }
        },
        "callbacks": {
          "onCreated": {
            "{$request.body#/callbackUrl}": {
              "post": { "operationId": "things.created.callback" }
            }
          }
        }
      }
    },
    "/things/deferred": {
      "get": {
        "operationId": "things.deferred",
        "summary": "An operation whose responses the build could not recover"
      }
    },
    "/shared": {
      "$ref": "#/components/pathItems/Shared",
      "summary": "A path item OpenAPI 3.0 has no components.pathItems to reference"
    }
  },
  "webhooks": {
    "thingCreated": {
      "post": {
        "operationId": "things.webhook.created",
        "responses": { "200": { "description": "Acknowledged" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "properties": {
          "kind": { "const": "widget" },
          "flag": { "type": "boolean", "const": true, "enum": [true, false] },
          "payload": { "type": "string", "contentMediaType": "application/json" },
          "avatar": { "type": "string", "contentEncoding": "base64" },
          "signature": { "type": "string", "contentEncoding": "quoted-printable" },
          "nothing": { "type": "null" },
          "labels": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer" }], "items": { "type": "string" } },
          "extras": { "type": "object", "patternProperties": { "^x-": { "type": "string" } }, "unevaluatedProperties": false },
          "branch": { "if": { "type": "string" }, "then": { "maxLength": 4 }, "else": { "type": "integer" } },
          "status": { "anyOf": [{ "$ref": "#/components/schemas/Status" }, { "type": "null" }] },
          "size": { "anyOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "nickname": { "anyOf": [{ "type": "string", "maxLength": 20 }, { "type": "null" }] },
          "weight": { "type": ["number", "string"], "anyOf": [{ "type": "number" }, { "type": "string" }] },
          "score": { "type": "integer", "examples": [1, 2, 3] },
          "note": { "type": "string", "examples": ["hello"], "example": "already set" }
        }
      },
      "Status": {
        "type": "string",
        "enum": ["draft", "published"]
      }
    },
    "responses": {
      "default": {
        "description": "A component named like a fixed field",
        "content": {
          "application/json": { "schema": { "type": ["string", "null"], "const": "unavailable" } }
        }
      },
      "example": {
        "description": "A component named like a member whose value is user data",
        "content": {
          "application/json": { "schema": { "type": "integer", "exclusiveMinimum": 0 } }
        }
      }
    },
    "examples": {
      "examples": { "summary": "An example in the bucket that really is one", "value": { "kind": "widget" } }
    },
    "headers": {
      "enum": { "description": "A component named like a schema keyword", "schema": { "type": ["boolean", "null"] } }
    },
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "name": "X-Api-Key", "in": "header" },
      "clientCert": { "type": "mutualTLS", "description": "Client certificate authentication" }
    },
    "links": {
      "parameters": {
        "operationId": "things.audit",
        "description": "A link component named like a fixed field of the object it is",
        "parameters": { "paths": "a link parameter keyed like a path-item map" }
      }
    },
    "pathItems": {
      "Shared": {
        "get": { "operationId": "shared.get", "responses": { "200": { "description": "ok" } } }
      }
    }
  },
  "x-docuccino": {
    "document": { "id": "doc:downlevel", "configHash": "cfg-downlevel", "contentHash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" },
    "generator": { "name": "docuccino/laravel", "version": "0.1.0", "specVersion": "1.0.0" }
  }
}
