{
  "$schema": "https://spec.docuccino.app/uir/1.0/schema.json",
  "uir": "1.0.0",
  "openapi": "3.2.0",
  "info": { "title": "Billing API", "version": "1.4.0" },
  "paths": {
    "/api/invoices": {
      "get": {
        "x-docuccino": { "id": "op:v1:aaaainvoiceindex" },
        "summary": "List invoices.",
        "parameters": [
          {
            "x-docuccino": { "id": "par:v1:aaaaaaaaaaaapage" },
            "name": "page",
            "in": "query",
            "schema": {
              "x-docuccino": {
                "provenance": [
                  { "producer": "integration:query-builder", "layer": "integration", "fields": ["type"],
                    "source": { "file": "app/Queries/InvoiceQuery.php", "line": 18, "symbol": "App\\Queries\\InvoiceQuery::paginate" } }
                ]
              },
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "x-docuccino": { "id": "par:v1:aaaaaaaaaaaasort" },
            "name": "sort",
            "in": "query",
            "schema": { "type": "array", "items": { "type": "string", "enum": ["total", "-total"] } }
          },
          {
            "x-docuccino": { "id": "par:v1:aaaaaaaaaatenant" },
            "name": "X-Tenant",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "x-docuccino": { "id": "res:v1:aaaaainvoicelist" },
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "x-docuccino": {
                    "provenance": [
                      { "producer": "inference", "layer": "inference", "fields": ["items", "type"], "confidence": 0.9 }
                    ]
                  },
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Invoice" }
                },
                "example": [{ "total": 12.5, "reference": "INV-1", "lines": [] }]
              }
            }
          }
        }
      },
      "post": {
        "x-docuccino": { "id": "op:v1:aaaainvoicestore" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvoiceDraft" }
            }
          }
        },
        "responses": {
          "201": {
            "x-docuccino": { "id": "res:v1:aaaaainvoicemade" },
            "description": "Created",
            "headers": {
              "Location": {
                "required": true,
                "description": "Where the new invoice lives.",
                "schema": {
                  "x-docuccino": {
                    "provenance": [
                      { "producer": "integration:redirect", "layer": "integration", "fields": ["type"],
                        "source": { "file": "app/Http/Controllers/InvoiceController.php", "line": 44, "symbol": "App\\Http\\Controllers\\InvoiceController::store" } }
                    ]
                  },
                  "type": "string"
                }
              },
              "X-RateLimit-Remaining": { "schema": { "type": "integer", "minimum": 0 }, "example": 4 },
              "X-Chunk": { "schema": { "type": "integer" } },
              "Content-Type": { "schema": { "type": "integer" } },
              "X-Signature": { "content": { "application/jose": { "schema": { "type": "string" } } } },
              "X-Legacy": { "$ref": "#/components/headers/Legacy" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } }
          },
          "4XX": {
            "x-docuccino": { "id": "res:v1:aaaaaainvoicebad" },
            "description": "Invalid",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/invoices/recent": {
      "get": {
        "x-docuccino": { "id": "op:v1:aaainvoicerecent" },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Invoice" } } } }
          }
        }
      }
    },
    "/api/invoices/{invoice}": {
      "parameters": [
        {
          "x-docuccino": { "id": "par:v1:aaaaaaainvoiceid" },
          "name": "invoice",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "x-docuccino": { "id": "op:v1:aaaaainvoiceshow" },
        "responses": {
          "200": {
            "x-docuccino": { "id": "res:v1:aaaaaainvoiceone" },
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } }
          },
          "default": {
            "description": "Error",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      },
      "delete": {
        "x-docuccino": { "id": "op:v1:aaaaainvoicekill" },
        "responses": { "204": { "description": "No content" } }
      }
    },
    "/api/exports": {
      "get": {
        "x-docuccino": { "id": "op:v1:aaaaaexportsfeed" },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "text/csv": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  },
  "webhooks": {
    "alert.raised": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaaalertraised" },
        "requestBody": {
          "required": true,
          "content": { "application/json": {} }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "digest.sent": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaaadigestsent" },
