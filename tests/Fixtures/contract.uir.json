        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "export.ready": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaaexportready" },
        "requestBody": {
          "required": true,
          "content": { "text/csv": { "schema": { "type": "string" } } }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "invoice.paid": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaainvoicepaid" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } }
          }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "invoice.voided": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaaavoidedpost" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } }
          }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      },
      "put": {
        "x-docuccino": { "id": "op:v1:aaaaaaavoidedput" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } }
          }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "ping.sent": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaaaaapingsent" },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    },
    "receipt.sent": {
      "post": {
        "x-docuccino": { "id": "op:v1:aaaaareceiptsent" },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } },
            "application/xml": { "schema": { "type": "string" } }
          }
        },
        "responses": { "200": { "description": "Delivery accepted." } }
      }
    }
  },
  "components": {
    "headers": {
      "Legacy": { "description": "Sent while the old client is still out there.", "schema": { "type": "boolean" } }
    },
    "schemas": {
      "Invoice": {
        "x-docuccino": {
          "id": "sch:v1:aaaainvoiceshape",
          "provenance": [
            { "producer": "integration:eloquent", "layer": "integration", "fields": ["properties"],
              "source": { "file": "app/Models/Invoice.php", "line": 22, "symbol": "App\\Models\\Invoice" } }
          ]
        },
        "type": "object",
        "properties": {
          "reference": { "type": "string" },
          "total": {
            "x-docuccino": {
              "provenance": [
                { "producer": "integration:eloquent", "layer": "integration", "fields": ["type"],
                  "source": { "file": "app/Models/Invoice.php", "line": 31, "symbol": "App\\Models\\Invoice::$total" } }
              ]
            },
            "type": "number"
          },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/Line" } }
        },
        "required": ["reference", "total"]
      },
      "Line": {
        "x-docuccino": { "id": "sch:v1:aaaaaaalineshape" },
        "type": "object",
        "properties": {
          "quantity": { "type": "integer", "example": 3 },
          "child": { "$ref": "#/components/schemas/Line" }
        },
        "required": ["quantity"]
      },
      "InvoiceDraft": {
        "x-docuccino": {
          "id": "sch:v1:aaaaaadraftshape",
          "provenance": [
            { "producer": "integration:form-request", "layer": "integration", "fields": ["properties"],
              "source": { "file": "app/Http/Requests/StoreInvoice.php", "line": 14, "symbol": "App\\Http\\Requests\\StoreInvoice::rules" } }
          ]
        },
        "type": "object",
        "properties": { "reference": { "type": "string", "minLength": 3 } },
        "required": ["reference"]
      },
      "Problem": {
        "x-docuccino": { "id": "sch:v1:aaaaproblemshape" },
        "type": "object",
        "properties": { "detail": { "type": "string" } },
        "required": ["detail"]
      }
    }
  }
